# ========================================================
# CẤU HÌNH TELEGRAM BOT BÁO GIÁ VÀNG 9999
# ========================================================

# 1. Token bot lấy từ @BotFather trên Telegram
# Mở Telegram tìm @BotFather -> gõ /newbot -> làm theo hướng dẫn để nhận Token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Lịch gửi tin tự động (Mặc định: 08:00 sáng mỗi ngày)
# Cú pháp cron: Phút Giờ Ngày Tháng Thứ
CRON_SCHEDULE=0 8 * * *

# 3. Múi giờ Việt Nam
TIMEZONE=Asia/Ho_Chi_Minh

# 4. Chat ID mặc định (Không bắt buộc)
# Người dùng chỉ cần mở Telegram tìm bot và bấm /start là bot tự nhận diện và lưu Chat ID!
DEFAULT_CHAT_ID=
